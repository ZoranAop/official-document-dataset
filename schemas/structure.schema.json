{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Document Structure Schema",
  "description": "文档结构分析Schema",
  "type": "object",
  "required": ["pattern_id", "sections"],
  "properties": {
    "pattern_id": {
      "type": "string",
      "description": "结构模式ID",
      "example": "instruction_v1"
    },
    "confidence": {
      "type": "number",
      "description": "匹配置信度",
      "minimum": 0,
      "maximum": 1
    },
    "sections": {
      "type": "array",
      "description": "文档段落结构",
      "items": {
        "type": "object",
        "required": ["type", "summary"],
        "properties": {
          "type": {
            "type": "string",
            "description": "段落类型",
            "enum": [
              "opening",
              "background",
              "context",
              "main_judgment",
              "core_requirement",
              "explanation",
              "implementation",
              "closing",
              "other"
            ]
          },
          "summary": {
            "type": "string",
            "description": "段落摘要"
          },
          "key_points": {
            "type": "array",
            "description": "关键点列表",
            "items": {
              "type": "string"
            }
          },
          "start_position": {
            "type": "integer",
            "description": "段落起始位置"
          },
          "end_position": {
            "type": "integer",
            "description": "段落结束位置"
          },
          "text_snippet": {
            "type": "string",
            "description": "文本片段（前100字）"
          }
        }
      }
    },
    "argument_flow": {
      "type": "object",
      "description": "论述流程",
      "properties": {
        "logic_type": {
          "type": "string",
          "description": "逻辑类型",
          "enum": [
            "总-分-总",
            "背景-问题-方案",
            "判断-要求-实施",
            "其他"
          ]
        },
        "transition_points": {
          "type": "array",
          "description": "转折点和过渡句",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "证据链 - 支撑该结构模式的源文档列表",
      "items": {
        "type": "object",
        "required": ["document_id"],
        "properties": {
          "document_id": {
            "type": "string",
            "description": "源文档ID"
          },
          "title": {
            "type": "string",
            "description": "源文档标题"
          },
          "date": {
            "type": "string",
            "description": "发布日期"
          },
          "source_url": {
            "type": "string",
            "description": "原文链接"
          },
          "support": {
            "type": "string",
            "description": "支持说明 - 该文档如何支撑此模式"
          }
        }
      }
    },
    "statistics": {
      "type": "object",
      "description": "统计信息",
      "properties": {
        "sample_count": {
          "type": "integer",
          "description": "样本数量"
        },
        "section_frequency": {
          "type": "object",
          "description": "各段落类型出现频率",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "version_info": {
      "type": "object",
      "description": "版本信息",
      "properties": {
        "analysis_version": {
          "type": "string",
          "description": "分析版本"
        },
        "dataset_version": {
          "type": "string",
          "description": "数据集版本"
        },
        "source_snapshot": {
          "type": "string",
          "description": "数据快照日期"
        },
        "analysis_period": {
          "type": "object",
          "description": "分析时间窗口",
          "properties": {
            "start": {
              "type": "string",
              "description": "开始日期"
            },
            "end": {
              "type": "string",
              "description": "结束日期"
            }
          }
        }
      }
    }
  }
}
