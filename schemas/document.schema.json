{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Official Document Schema",
  "description": "官方文献标准Schema定义",
  "type": "object",
  "required": ["id", "title", "date", "source", "source_url"],
  "properties": {
    "id": {
      "type": "string",
      "description": "文档唯一标识",
      "pattern": "^people_\\d{8}_\\d+$",
      "example": "people_20260918_40803352"
    },
    "title": {
      "type": "string",
      "description": "文档标题",
      "minLength": 1,
      "maxLength": 500
    },
    "date": {
      "type": "string",
      "description": "发布日期",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "description": "来源媒体",
      "enum": ["人民日报", "新华社", "求是"]
    },
    "source_url": {
      "type": "string",
      "description": "原文链接",
      "format": "uri"
    },
    "document_type": {
      "type": "string",
      "description": "文档类型",
      "enum": ["讲话", "会议", "活动", "考察", "会见", "出访", "函电", "其他"]
    },
    "document_subtype": {
      "type": "string",
      "description": "文档子类型",
      "enum": ["重要讲话", "重要指示", "一般讲话", "一般指示"]
    },
    "category": {
      "type": "string",
      "description": "分类",
      "enum": ["最新", "国内", "国际"]
    },
    "domains": {
      "type": "array",
      "description": "领域标签",
      "items": {
        "type": "string",
        "enum": ["经济", "政治", "文化", "社会", "生态", "党建", "国防", "外交"]
      }
    },
    "event": {
      "type": "string",
      "description": "事件名称"
    },
    "location": {
      "type": "string",
      "description": "地点"
    },
    "subjects": {
      "type": "array",
      "description": "主题列表",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "description": "关键词列表",
      "items": {
        "type": "string"
      }
    },
    "structure": {
      "type": "object",
      "description": "文档结构分析结果",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["opening", "background", "context", "main_judgment", "core_requirement", "explanation", "implementation", "closing", "other"]
              },
              "summary": {
                "type": "string"
              },
              "start_position": {
                "type": "integer"
              },
              "end_position": {
                "type": "integer"
              }
            }
          }
        },
        "pattern_id": {
          "type": "string",
          "description": "匹配的结构模式ID"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "themes": {
      "type": "array",
      "description": "论述主题",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["核心目标", "总体要求", "基本原则", "重点任务", "保障措施"]
          },
          "position": {
            "type": "string",
            "enum": ["opening", "background", "main_body", "requirements", "closing"]
          }
        }
      }
    },
    "policy_points": {
      "type": "array",
      "description": "政策要点",
      "items": {
        "type": "string"
      }
    },
    "source_text": {
      "type": "string",
      "description": "原始文本（脱敏后）"
    },
    "normalized_text": {
      "type": "string",
      "description": "标准化文本"
    },
    "content_hash": {
      "type": "string",
      "description": "内容哈希值（SHA256）",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema版本",
      "default": "1.0"
    },
    "metadata": {
      "type": "object",
      "description": "元数据",
      "properties": {
        "crawl_at": {
          "type": "string",
          "format": "date-time"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["raw", "normalized", "structured", "analyzed"]
        }
      }
    }
  }
}
